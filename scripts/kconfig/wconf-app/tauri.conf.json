{
    "productName": "Kernel Configuration",
    "version": "0.1.0",
    "identifier": "org.kernel.wconf",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:5173",
        "frontendDist": "dist"
    },
    "app": {
        "withGlobalTauri": true,
        "security": {
            "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; img-src 'self' data:; connect-src 'self' ws: wss: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'"
        },
        "windows": [
            {
                "label": "main",
                "title": "Kernel Configuration",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "center": true,
                "skipTaskbar": false,
                "alwaysOnTop": false,
                "visible": true,
                "theme": "Dark",
                "url": "../dist/index.html"
            }
        ]
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "icon": ["icons/32x32.png"],
      "shortDescription": "Linux Kernel Configuration Tool",
      "targets": ["app"]
    }
}

